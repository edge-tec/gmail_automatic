# Application Settings
APP_NAME="Gmail Automation Engine"
APP_ENV=production
APP_KEY=base64:32characterRandomSecretKeyForEncryption==
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

# Database Configuration (MySQL / MariaDB / SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gmail_automation
DB_USERNAME=gmail_user
DB_PASSWORD=secret_password

# For local development with SQLite, set:
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database/database.sqlite

# Google Cloud OAuth 2.0 Credentials
# (Can also be configured via Web UI Admin Panel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Pub/Sub Webhook Verification Token (Optional push notification)
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PUBSUB_TOPIC=

# Automation Engine Settings
AUTO_REPLY_DEFAULT_DELAY=0
DEFAULT_MAX_REPLY_PER_THREAD=3
DEFAULT_DAILY_REPLY_LIMIT=100
DEFAULT_DAILY_FOLLOWUP_LIMIT=100

# Worker Settings
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_SECONDS=60
QUEUE_BATCH_SIZE=25
