{
    "name": "mizanurrahman/gmail-auto-reply-automation",
    "description": "Production-Ready Gmail Auto Reply and Follow-up Automation System in PHP 8.2+ and MySQL",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Mizanur Rahman",
            "email": "developer@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "google/apiclient": "^2.15",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
